# Monitor7adi Environment Variables
# Copy this file to .env and fill in your API keys

# === THREAT INTELLIGENCE ===

# VirusTotal - https://www.virustotal.com/gui/join-us (gratuit: 500 req/jour)
VIRUSTOTAL_API_KEY=

# Shodan - https://account.shodan.io/register (gratuit: 100 req/mois)
SHODAN_API_KEY=

# MISP - Instance privée requise
MISP_API_KEY=
MISP_URL=https://your-misp-instance/

# AlienVault OTX - https://otx.alienvault.com/api (gratuit illimité)
OTX_API_KEY=

# AbuseIPDB - https://www.abuseipdb.com/account/api (gratuit: 1000 req/jour)
ABUSEIPDB_API_KEY=

# HaveIBeenPwned - https://haveibeenpwned.com/API/Key (payant: ~$3.50/mois)
HIBP_API_KEY=

# === OSINT TOOLS (10 outils intégrés) ===

# Criminal IP - https://www.criminalip.io/mypage/information (gratuit: 50 crédits/mois)
CRIMINALIP_API_KEY=

# isMalicious - https://ismalicious.com/api (gratuit avec limites)
ISMALICIOUS_API_KEY=

# ZoomEye - https://www.zoomeye.org/profile (gratuit: 10000 req/mois)
ZOOMEYE_API_KEY=

# Elasticsearch / SIEM Integration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Ollama (Local LLM)
OLLAMA_URL=http://localhost:11434

# Redis
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=production
LOG_LEVEL=info
